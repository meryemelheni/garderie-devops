# Inventaire pour une exécution manuelle depuis l'hôte :
#   ansible-playbook -i inventory site.yml
# (Avec Vagrant ansible_local, un inventaire est généré automatiquement.)
[garderie]
garderie-vm ansible_host=192.168.56.10 ansible_user=vagrant ansible_ssh_private_key_file=../.vagrant/machines/default/virtualbox/private_key ansible_ssh_common_args='-o StrictHostKeyChecking=no'
